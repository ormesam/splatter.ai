.bt-canvas {
    flex-grow: 1;
    overflow: hidden;
    background-color: #1e1e1e;
}

.node {
    position: absolute;
    width: 180px;
    min-height: 44px;
    background-color: #383838;
    border-width: 1px;
    border-color: #191919;
    border-radius: 6px;
}

.node-title {
    flex-direction: row;
    align-items: center;
    background-color: #2b2b2b;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 4px 6px;
}

.node-title-label {
    flex-grow: 1;
    -unity-font-style: bold;
}

.node .type-label {
    font-size: 9px;
    -unity-font-style: italic;
    opacity: 0.6;
    margin: 2px 6px 4px 6px;
}

.node .index-label {
    font-size: 10px;
    opacity: 0.8;
    margin-left: 4px;
}

.node.running {
    border-color: rgb(184, 135, 10);
}

.node.subtree {
    border-width: 2px;
    border-color: #4A90D9;
}

.blackboard-panel {
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.bb-row {
    flex-direction: row;
    justify-content: space-between;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.bb-key {
    -unity-font-style: bold;
    margin-right: 8px;
}

.bb-value {
    flex-shrink: 1;
    overflow: hidden;
}

.empty-state {
    position: absolute;
    left: 0;
    right: 0;
    top: 45%;
    -unity-text-align: middle-center;
    font-size: 13px;
    opacity: 0.6;
}
