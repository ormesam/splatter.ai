.node {
    width: 180px;
}

.node .type-label {
    font-size: 9px;
    -unity-font-style: italic;
    opacity: 0.6;
    margin-left: 4px;
    align-self: center;
}

.node .index-label {
    font-size: 10px;
    opacity: 0.8;
    margin-right: 4px;
    align-self: center;
}

.node.subtree #node-border {
    border-left-color: #4A90D9;
    border-right-color: #4A90D9;
    border-top-color: #4A90D9;
    border-bottom-color: #4A90D9;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.blackboard-panel {
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.bb-row {
    flex-direction: row;
    justify-content: space-between;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.bb-key {
    -unity-font-style: bold;
    margin-right: 8px;
}

.bb-value {
    flex-shrink: 1;
    overflow: hidden;
}

.empty-state {
    position: absolute;
    left: 0;
    right: 0;
    top: 45%;
    -unity-text-align: middle-center;
    font-size: 13px;
    opacity: 0.6;
}
